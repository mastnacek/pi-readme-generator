{
  "name": "pi-readme-generator",
  "version": "0.2.0",
  "description": "Skill-driven README generation: the agent writes the README, the plugin analyzes the project and commits only the README file",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension"
  ],
  "author": "mastnacek",
  "license": "MIT",
  "files": [
    "README.md",
    "package.json",
    "./index.ts",
    "dist",
    "src",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/readme-generator",
      "./skills/pi_project_registry"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test \"dist/test/*.test.js\""
  }
}

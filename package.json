{
  "name": "pi-readme-generator",
  "version": "0.1.0",
  "description": "Analyzes projects, generates/updates README.md with best practices, and manages git commits with TUI status display",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension"
  ],
  "author": "mastnacek",
  "license": "MIT",
  "files": [
    "README.md",
    "package.json",
    "./index.ts",
    "dist",
    "src"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js"
  }
}
